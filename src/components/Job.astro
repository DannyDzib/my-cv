---
import type { Job } from '../data/types';
import { richText } from '../utils/format';

interface Props {
  job: Job;
}

const { job } = Astro.props;
---

<article class="job">
  <header class="job__header">
    <h3 class="job__company">{job.company}</h3>
    <p class="job__meta">
      <span class="job__role">{job.role}</span>
      <time class="job__period">{job.period}</time>
    </p>
  </header>

  {
    job.projects?.map((project) => (
      <div class="project">
        <h4 class="project__name">{project.name}</h4>
        <ul class="bullets">
          {project.bullets.map((b) => (
            <li set:html={richText(b)} />
          ))}
        </ul>
      </div>
    ))
  }

  {
    job.bullets && (
      <ul class="bullets">
        {job.bullets.map((b) => (
          <li set:html={richText(b)} />
        ))}
      </ul>
    )
  }
</article>
